# Server Configuration
PORT=4000
NODE_ENV=development
API_VERSION=v1
CORS_ORIGIN=*

# MongoDB Database URI (Use replica set for multi-document transactions)
MONGODB_URI=mongodb://127.0.0.1:27017/theypayontime?replicaSet=rs0
MONGODB_USE_TRANSACTIONS=true

# Authentication Secrets
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Regulatory and Compliance Feature Flags
# Live consumer reporting must remain disabled until regulatory/legal approval
ENABLE_LIVE_CONSUMER_REPORTING=false
REQUIRE_PERMISSIBLE_PURPOSE_ATTESTATION=true

# Storage and Evidence Uploads
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760

# Push Notifications (FCM / APNS)
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
